# ─── LLM gateway ───────────────────────────────────────────
# provider abstraction: LiteLLM-style model name (provider/model)

# (A) Anthropic Claude (production default)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=anthropic/claude-sonnet-5
LLM_MODEL_FAST=anthropic/claude-haiku-4-5-20251001
LLM_API_BASE=

# (B) local Ollama (free local testing) — uncomment below and replace the 3 lines above
# LLM_MODEL=ollama_chat/llama3.1:8b
# LLM_MODEL_FAST=ollama_chat/llama3.1:8b
# LLM_API_BASE=http://localhost:11434

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ─── data / state (lightweight first) ──────────────────────────────────
# default: SQLite. For production use postgresql+psycopg://user:pass@host/db
DB_URL=sqlite:///./ma_pmo.db
CHECKPOINT_DB=./ma_pmo_checkpoints.sqlite

# ─── HITL / governance ─────────────────────────────────────────
# messages with confidence below this go to the approval queue automatically
HITL_CONFIDENCE_THRESHOLD=0.6

# ─── API ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── API authentication (docs/AUTH.md) ─────────────────────────────
# off (default, local only) | api_key | custom
MA_PMO_AUTH_MODE=off
# api_key mode: name:role+role:key, comma-separated (roles: viewer, operator, approver, admin)
# MA_PMO_API_KEYS=alice:approver:<openssl rand -hex 24>,ci-bot:operator:<...>
# custom mode: package.module:factory returning an object with authenticate(request)
# MA_PMO_AUTHENTICATOR=
# dashboard (apps/web): key sent as X-API-Key when auth is on
# NEXT_PUBLIC_API_KEY=

# ─── observability (optional, switch on later) ─────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
OTEL_ENABLED=false
# tracing of agent runs (pip install "ma-pmo[otel]", see infra/otel/README.md):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=ma-pmo

# language: default for generated text and LLM output (en | ko).
# The API also honors ?lang=ko or the Accept-Language header per request.
MA_PMO_LANG=en

# integrations (see docs/INTEGRATIONS.md). Comma-separated: slack, webhook, jira
MA_PMO_INTEGRATIONS=
# only send these event types (empty = all): approval.requested, approval.resolved,
# risk.detected, gate.failed, report.generated
MA_PMO_NOTIFY_EVENTS=
MA_PMO_PUBLIC_URL=http://localhost:3000
# Slack incoming webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# generic JSON webhook (n8n, Zapier, your own service)
MA_PMO_WEBHOOK_URL=
# Jira Cloud: API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=
JIRA_STORY_POINTS_FIELD=
